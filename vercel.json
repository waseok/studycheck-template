{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd backend && npm install && cd ../frontend && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/onboarding/[...path].ts": {
      "maxDuration": 60
    },
    "api/ping.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/settings/status.ts": {
      "maxDuration": 15
    },
    "api/settings/public.ts": {
      "maxDuration": 15
    }
  }
}
