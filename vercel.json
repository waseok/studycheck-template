{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd backend && npm install --include=dev && cd ../frontend && npm install --include=dev",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/onboarding/(.*)",
      "destination": "/api/onboarding-router?path=$1"
    },
    {
      "source": "/api/onboarding",
      "destination": "/api/onboarding-router"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{backend/prisma/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**}"
    },
    "api/onboarding-router.ts": {
      "maxDuration": 60,
      "includeFiles": "{backend/prisma/**,scripts/vercel-build.mjs,api/index.ts,vercel.json}"
    },
    "api/ping.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}
