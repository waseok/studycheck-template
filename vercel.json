{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "installCommand": "node scripts/vercel-install.mjs",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/onboarding/(.*)",
      "destination": "/api/onboarding-router?path=$1"
    },
    {
      "source": "/api/onboarding",
      "destination": "/api/onboarding-router"
    },
    {
      "source": "/api/settings/status",
      "destination": "/api/settings/status"
    },
    {
      "source": "/api/settings/public",
      "destination": "/api/settings/public"
    },
    {
      "source": "/api/settings/setup",
      "destination": "/api/settings/setup"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{backend/prisma/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**}"
    },
    "api/onboarding-router.ts": {
      "maxDuration": 60,
      "includeFiles": "{backend/prisma/**,scripts/vercel-build.mjs,scripts/vercel-install.mjs,api/index.ts,api/settings/**,vercel.json}"
    },
    "api/settings/status.ts": {
      "maxDuration": 15,
      "includeFiles": "{backend/prisma/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**}"
    },
    "api/settings/public.ts": {
      "maxDuration": 15,
      "includeFiles": "{backend/prisma/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**}"
    },
    "api/settings/setup.ts": {
      "maxDuration": 30,
      "includeFiles": "{backend/prisma/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**}"
    },
    "api/ping.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}
