{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd backend && npm install && cd ../frontend && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/onboarding/github/repo.ts": {
      "maxDuration": 60
    },
    "api/onboarding/github/connect.ts": {
      "maxDuration": 30
    },
    "api/onboarding/vercel/project.ts": {
      "maxDuration": 60
    },
    "api/onboarding/vercel/link.ts": {
      "maxDuration": 60
    },
    "api/onboarding/vercel/teams.ts": {
      "maxDuration": 30
    },
    "api/onboarding/session.ts": {
      "maxDuration": 30
    },
    "api/onboarding/supabase/resources.ts": {
      "maxDuration": 30
    },
    "api/onboarding/supabase/project.ts": {
      "maxDuration": 60
    },
    "api/onboarding/supabase/connect.ts": {
      "maxDuration": 30
    },
    "api/onboarding/provision.ts": {
      "maxDuration": 60
    }
  }
}
